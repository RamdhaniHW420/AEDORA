# Salin menjadi .env lalu isi.

# --- AI (Google Gemini), dipanggil langsung dari aplikasi. Kunci dari https://aistudio.google.com/apikey ---
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest

# --- Firebase: Project settings > Your apps > Web app (lihat FIREBASE_SETUP.md) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Opsional: server dashboard guru sebagai cadangan AI (mis. http://192.168.1.10:3000) ---
EXPO_PUBLIC_API_BASE=
